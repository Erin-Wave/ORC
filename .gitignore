# Data is never committed.  Panels are rebuilt from the vendor archive and
# shipped to the worker as a release asset instead.
facts/panel_1m/
facts/panel_1h/
facts/funding/
# Open interest and taker flow, rebuilt by `python -m orc.facts.positioning`.
# Listed for the same reason as the panels, and for one more: the store holds
# the FULL history including the sealed side, because positioning.load() is
# what truncates. A committed copy would put sealed bars in every checkout.
facts/positioning/
dist/

# The token that opens the sealed holdout is a deliberate local act.  Committing
# it would let any checkout consume an opening.
FINAL_TEST_TOKEN

__pycache__/
*.pyc
.pytest_cache/
.venv/

# Reasoning-cycle logs and the local NEWS.md the notifier appends to are
# operational noise, not research output.
logs/

# scripts/mutation.py works in a throwaway copy of the tree; it removes it on
# success and a crashed run must not leave it committable.
.mutation/

# The differential oracle's scratch. ref_signal.py IS committed -- it is the
# check -- but the raw provider output it was cut from is not.
oracle/_raw.py
